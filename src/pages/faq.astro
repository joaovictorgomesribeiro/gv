---
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
	{
		question: "O que é terceirizável?",
		answer:
			"Atividades de logística interna (carregamento, picking, armazenagem, gestão de estoque), produção (operação de máquinas e empilhadeiras, apontamento, supervisão de linha) e outras atividades como administrativo, medicina e segurança do trabalho. Veja a lista completa na seção Setores da página inicial.",
	},
	{
		question: "Como funciona a reposição em caso de falta?",
		answer:
			"A GV mantém um sistema de backup: um profissional preparado para cobrir a ausência de um colaborador, para que a operação do cliente não seja impactada.",
	},
	{
		question: "Qual o prazo de contratação?",
		answer:
			"Prazo mínimo, vigência e condições de contrato variam conforme o escopo do projeto. Fale com a gente pelo WhatsApp para alinhar o prazo ideal para a sua operação.",
	},
	{
		question: "De quem é a responsabilidade trabalhista?",
		answer:
			"Na terceirização, a GV é a empregadora dos profissionais alocados: responsável pela folha de pagamento, encargos trabalhistas, férias e exames médicos admissionais e periódicos. Esta resposta é uma explicação geral do modelo de terceirização e não substitui orientação jurídica sobre o seu caso específico.",
	},
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
};
---

<BaseLayout
	title="Perguntas frequentes | GV Soluções Empresariais"
	description="Tire suas dúvidas sobre terceirização de mão de obra com a GV Soluções Empresariais: o que é terceirizável, reposição por falta, prazos e responsabilidade trabalhista."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<section class="faq">
		<h1>Perguntas frequentes</h1>

		<div class="faq-list">
			{
				faqs.map((item) => (
					<details class="faq-item">
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))
			}
		</div>

		<p class="faq-cta-text">Não encontrou o que precisava?</p>
		<WhatsAppCTA
			message="Olá, tenho uma dúvida sobre terceirização que não encontrei no FAQ."
			label="Perguntar pelo WhatsApp"
		/>
	</section>
</BaseLayout>

<style>
	.faq {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem 1.25rem;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 2rem 0;
	}

	.faq-item {
		border: var(--border-hairline);
		border-radius: var(--radius-sm);
	}

	.faq-item summary {
		cursor: pointer;
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0.85rem 1.25rem;
		font-weight: var(--weight-semibold);
		color: var(--color-navy-900);
	}

	.faq-item p {
		margin: 0;
		padding: 0 1.25rem 1rem;
		color: var(--color-gray-700);
	}

	.faq-cta-text {
		margin-top: 2rem;
		font-weight: var(--weight-semibold);
	}
</style>
