---
import PendingPlaceholder from "../components/PendingPlaceholder.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const servicos = [
	{
		title: "Contratação de talentos inteligentes em tempo hábil",
		description:
			"Recrutamento e seleção para atender ao cronograma do cliente, sem atrasar a operação.",
	},
	{
		title: "Integração à cultura da empresa",
		description:
			"Onboarding alinhado à cultura, aos processos e aos sistemas do cliente.",
	},
	{
		title: "Treinamento e qualificação da equipe",
		description:
			"Capacitação contínua de líderes, técnicos, assistentes e auxiliares.",
	},
	{
		title: "Acompanhamento na execução das atividades",
		description:
			"Gestão próxima, comparação de desempenho e identificação de necessidades de treinamento.",
	},
	{
		title: "Sistema de backup",
		description: "Substituto preparado para cobrir ausências sem impacto na operação.",
	},
	{
		title: "Gestão da folha de pagamento e exames médicos",
		description:
			"Folha, encargos trabalhistas, controle de férias e exames admissionais e periódicos.",
	},
	{
		title: "Gestão e entrega de EPIs e uniformes",
		description: "EPIs e uniformes adequados a cada atividade e às normas vigentes.",
	},
	{
		title: "Atualização das práticas de segurança para toda a empresa",
		description: "Melhorias de segurança comunicadas e aplicadas junto ao cliente.",
	},
	{
		title: "Sinergia entre a GV e a contratante",
		description: "Operação contratada conduzida 100% pela GV, com comunicação aberta.",
	},
	{
		title: "Foco no resultado do cliente",
		description: "Resultados positivos, esforço extra e revisão flexível de processos.",
	},
];

const setores = [
	{
		title: "Logística Interna",
		items: [
			{ label: "Carregamento e descarregamento de caminhões", icon: "logistica-carga-e-descarga" },
			{ label: "Picking e conferência de pedidos", icon: "logistica-picking" },
			{
				label: "Conferência de recebimento e expedição",
				icon: "logistica-conferencia-recebimento-expedicao",
			},
			{ label: "Processamento de pedidos", icon: "logistica-processamento-pedidos" },
			{ label: "Transporte interno", icon: "logistica-transporte-interno" },
			{ label: "Armazenagem e movimentação", icon: "logistica-movimentacao-armazenagem" },
			{ label: "Gestão de estoque", icon: "logistica-gestao-estoques" },
			{ label: "Gestão de almoxarifado e depósito", icon: "logistica-gestao-armazenagem" },
			{ label: "Embalagem (packing)", icon: "logistica-packing" },
		],
	},
	{
		title: "Produção",
		items: [
			{ label: "Gerente de produção", icon: "producao-gerente" },
			{ label: "Operador de máquina", icon: "producao-operador-maquinas" },
			{ label: "Operador de empilhadeira", icon: "producao-operador-empilhadeira" },
			{ label: "Auxiliar de produção", icon: "producao-auxiliar-producao" },
			{ label: "Conferente de carga", icon: "producao-conferente-carga" },
			{ label: "Auxiliar de armazém", icon: "producao-auxiliar-armazem" },
			{ label: "Apontador de produção", icon: "producao-apontador" },
			{ label: "Supervisor de linha", icon: "producao-supervisor-linha" },
			{ label: "Analista de PCP", icon: "producao-analista-pcp" },
			{
				label: "Operador de movimentação e armazenagem",
				icon: "producao-operador-movimentacao-armazenagem",
			},
		],
	},
	{
		title: "Outras Atividades",
		items: [
			{ label: "Atividades administrativas", icon: "outras-atividades-administrativas" },
			{ label: "Medicina do trabalho", icon: "outras-medicina-trabalho" },
			{ label: "Segurança do trabalho", icon: "outras-seguranca-trabalho" },
		],
	},
];

const beneficios = [
	"Mantenha o foco no core business e na estratégia",
	"Expanda o negócio de forma estruturada",
	"Priorize a qualidade",
	"Conte com profissionais especializados em cada etapa da operação",
	"Controle os custos operacionais",
	"Aumente o lucro e a produtividade",
];
---

<BaseLayout
	title="Terceirização de Serviços em Uberlândia | GV Soluções Empresariais"
	description="A GV Soluções Empresariais atua desde 2015 com terceirização de logística interna, produção e serviços administrativos em Uberlândia e região."
>
	<section class="hero" id="home">
		<div class="hero-inner">
			<h1>Terceirização de mão de obra em Uberlândia</h1>
			<p>
				Atuando desde 2015, somos especialistas em levar a solução completa para a
				sua empresa através da terceirização de logística interna, produção e
				serviços administrativos.
			</p>
			<WhatsAppCTA
				message="Olá, gostaria de solicitar um orçamento de terceirização."
				label="Solicitar orçamento pelo WhatsApp"
			/>
		</div>
	</section>

	<section class="sobre">
		<h2>Entregamos as melhores soluções para o seu negócio</h2>
		<p>
			Atuamos para agronegócio, indústria, centros de distribuição e segmentos
			semelhantes, com equipes para logística interna, produção, segurança e medicina
			do trabalho.
		</p>
		<a href="/sobre/">Saiba mais sobre a GV</a>
	</section>

	<section class="servicos" id="servicos">
		<h2>Serviços</h2>
		<ul class="card-grid">
			{
				servicos.map((servico) => (
					<li class="card">
						<h3>{servico.title}</h3>
						<p>{servico.description}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="setores">
		<h2>Setores que atuamos</h2>
		<div class="setores-grid">
			{
				setores.map((setor) => (
					<div class="setor">
						<h3>{setor.title}</h3>
						<ul class="setor-items">
							{setor.items.map((item) => (
								<li>
									<img
										src={`/images/icons/${item.icon}.webp`}
										alt=""
										width="40"
										height="40"
										loading="lazy"
									/>
									<span>{item.label}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="beneficios">
		<h2>Benefícios da terceirização</h2>
		<ul class="beneficios-list">
			{beneficios.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="portfolio" id="portfolio">
		<h2>Portfólio</h2>
		<p class="section-intro">
			Esta seção está em atualização: em breve traremos cases reais, números e
			depoimentos de clientes.
		</p>

		<h3 class="portfolio-subtitle">Números</h3>
		<ul class="card-grid">
			<li><PendingPlaceholder label="Anos de atuação" /></li>
			<li><PendingPlaceholder label="Clientes atendidos" /></li>
			<li><PendingPlaceholder label="Profissionais alocados" /></li>
		</ul>

		<h3 class="portfolio-subtitle">Cases</h3>
		<ul class="card-grid">
			<li><PendingPlaceholder label="Case de logística interna" /></li>
			<li><PendingPlaceholder label="Case de produção" /></li>
			<li><PendingPlaceholder label="Case de outro setor atendido" /></li>
		</ul>

		<h3 class="portfolio-subtitle">Depoimentos</h3>
		<ul class="card-grid">
			<li><PendingPlaceholder label="Depoimento de cliente 1" /></li>
			<li><PendingPlaceholder label="Depoimento de cliente 2" /></li>
		</ul>
	</section>

	<section class="cta-final">
		<div class="cta-final-inner">
			<h2>Vamos começar seu projeto?</h2>
			<WhatsAppCTA
				message="Olá, gostaria de falar sobre um projeto de terceirização."
				label="Entrar em contato pelo WhatsApp"
			/>
		</div>
	</section>
</BaseLayout>

<style>
	section {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 3rem 1.25rem;
	}

	.hero,
	.cta-final {
		max-width: none;
		padding: 0;
		background-color: var(--color-navy-900);
	}

	.hero-inner,
	.cta-final-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 4rem 1.25rem;
		text-align: center;
	}

	.hero-inner h1,
	.cta-final-inner h2 {
		color: var(--color-white);
	}

	.hero-inner p {
		max-width: 60ch;
		margin: 1rem auto 2rem;
		color: var(--color-gray-100);
	}

	.servicos,
	.beneficios {
		background-color: var(--color-gray-50);
		border-radius: var(--radius-md);
	}

	.beneficios-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.25rem 2.5rem;
		grid-template-columns: 1fr;
	}

	@media (min-width: 700px) {
		.beneficios-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.beneficios-list li {
		position: relative;
		padding: 0.85rem 0 0.85rem 1.75rem;
		border-bottom: 1px solid var(--color-gray-300);
	}

	.beneficios-list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 1.4rem;
		width: 0.65rem;
		height: 0.65rem;
		background-color: var(--color-orange-500);
		border-radius: 2px;
	}

	.card-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
		grid-template-columns: 1fr;
	}

	@media (min-width: 700px) {
		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1000px) {
		.card-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.card {
		border: var(--border-hairline);
		border-radius: var(--radius-sm);
		padding: 1.25rem;
		background-color: var(--color-white);
	}

	.card h3 {
		margin-top: 0;
	}

	.setores-grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr;
	}

	.setor-items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.setor-items li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.setor-items img {
		flex-shrink: 0;
	}

	@media (min-width: 800px) {
		.setores-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.section-intro {
		color: var(--color-gray-700);
		font-style: italic;
	}

	.portfolio-subtitle {
		margin-top: 2rem;
	}
</style>
