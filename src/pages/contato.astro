---
import SocialIcon from "../components/SocialIcon.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import { address, businessHours, cnpj, email, social } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Contato | GV Soluções Empresariais"
	description="Fale com a GV Soluções Empresariais pelo WhatsApp para solicitar orçamento de terceirização em Uberlândia e região."
>
	<section class="contato">
		<h1>Canais de contato</h1>
		<p>
			Atendemos solicitações comerciais pelo WhatsApp. Para enviar currículo, use a
			página <a href="/trabalhe-conosco/">Trabalhe Conosco</a>.
		</p>

		<WhatsAppCTA
			message="Olá, gostaria de solicitar um orçamento de terceirização."
			label="Solicitar orçamento pelo WhatsApp"
		/>

		<div class="info">
			<h2>Endereço</h2>
			<address>{address.full}</address>

			<h2>Horário de atendimento</h2>
			<p>{businessHours.label}</p>

			<h2>E-mail</h2>
			<p><a href={`mailto:${email}`}>{email}</a></p>

			<h2>CNPJ</h2>
			<p>{cnpj}</p>

			<h2>Redes sociais</h2>
			<ul class="social-links">
				<li>
					<a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
						<SocialIcon network="facebook" />
					</a>
				</li>
				<li>
					<a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<SocialIcon network="instagram" />
					</a>
				</li>
				<li>
					<a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
						<SocialIcon network="linkedin" />
					</a>
				</li>
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.contato {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem 1.25rem;
	}

	.info {
		margin-top: 2.5rem;
	}

	.info address {
		font-style: normal;
	}

	.social-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.75rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: var(--border-hairline);
		border-radius: var(--radius-sm);
		color: var(--color-navy-900);
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--color-orange-600);
		border-color: var(--color-orange-600);
	}
</style>
