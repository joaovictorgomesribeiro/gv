---
import { whatsappLink } from "../data/site";
---

<a
	class="sticky-whatsapp"
	href={whatsappLink("Olá, gostaria de solicitar um orçamento de terceirização.")}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Solicitar orçamento pelo WhatsApp"
>
	<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
		<path
			d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.26 4.9L2 22l5.25-1.38a9.96 9.96 0 0 0 4.79 1.22h.01c5.52 0 10-4.48 10-10s-4.49-9.84-10.01-9.84Zm0 18.17h-.01a8.3 8.3 0 0 1-4.23-1.16l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.27-4.4c0-4.58 3.73-8.3 8.31-8.3 2.22 0 4.3.87 5.87 2.44a8.24 8.24 0 0 1 2.43 5.87c0 4.58-3.73 8.26-8.31 8.26Zm4.54-6.2c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.9 2.41 1.02 2.58c.12.17 1.76 2.69 4.27 3.77.6.26 1.06.41 1.43.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.29Z"
		/>
	</svg>
	<span>WhatsApp</span>
</a>

<style>
	.sticky-whatsapp {
		display: none;
	}

	@media (max-width: 899px) {
		.sticky-whatsapp {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			position: fixed;
			right: 1rem;
			bottom: 1rem;
			z-index: 80;
			padding: 0.85rem 1.1rem;
			background-color: var(--color-orange-600);
			color: var(--color-white);
			text-decoration: none;
			font-weight: var(--weight-semibold);
			font-size: var(--text-sm);
			border-radius: 999px;
			box-shadow: 0 10px 24px -6px rgba(19, 33, 60, 0.45);
		}

		.sticky-whatsapp:hover,
		.sticky-whatsapp:focus-visible {
			background-color: var(--color-orange-700);
			color: var(--color-white);
		}

		body.nav-open .sticky-whatsapp {
			display: none;
		}
	}
</style>
