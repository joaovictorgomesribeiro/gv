---
import { navItems } from "../data/nav";
import { siteName } from "../data/site";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="bar">
		<a href="/" class="brand">{siteName}</a>

		<button
			id="nav-toggle"
			class="nav-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<span class="sr-only">Abrir menu</span>
			<span class="nav-toggle-icon" aria-hidden="true"></span>
		</button>
	</div>

	<nav id="primary-nav" class="primary-nav" aria-label="Navegação principal">
		<ul>
			{
				navItems.map((item) => (
					<li>
						<a
							href={item.href}
							aria-current={currentPath === item.href ? "page" : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<button type="button" id="nav-backdrop" class="nav-backdrop" tabindex="-1" aria-hidden="true">
		<span class="sr-only">Fechar menu</span>
	</button>
</header>

<script>
	const toggle = document.getElementById("nav-toggle");
	const nav = document.getElementById("primary-nav");
	const backdrop = document.getElementById("nav-backdrop");

	function closeMenu() {
		toggle?.setAttribute("aria-expanded", "false");
		nav?.classList.remove("is-open");
		document.body.classList.remove("nav-open");
	}

	function openMenu() {
		toggle?.setAttribute("aria-expanded", "true");
		nav?.classList.add("is-open");
		document.body.classList.add("nav-open");
	}

	toggle?.addEventListener("click", () => {
		const expanded = toggle.getAttribute("aria-expanded") === "true";
		if (expanded) {
			closeMenu();
		} else {
			openMenu();
		}
	});

	backdrop?.addEventListener("click", closeMenu);

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMenu();
	});

	nav?.addEventListener("click", (event) => {
		if ((event.target as HTMLElement).tagName === "A") closeMenu();
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.site-header {
		position: relative;
		background-color: var(--color-white);
	}

	.bar {
		position: relative;
		z-index: 70;
		max-width: var(--content-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: var(--border-hairline);
		background-color: var(--color-white);
	}

	.brand {
		font-family: var(--font-serif);
		font-weight: var(--weight-semibold);
		font-size: var(--text-md);
		color: var(--color-navy-900);
		text-decoration: none;
	}

	.nav-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		background: none;
		border: var(--border-hairline);
		border-radius: var(--radius-sm);
		cursor: pointer;
	}

	.nav-toggle-icon,
	.nav-toggle-icon::before,
	.nav-toggle-icon::after {
		display: block;
		width: 1.25rem;
		height: 2px;
		background-color: var(--color-navy-900);
		position: relative;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.nav-toggle-icon::before {
		content: "";
		position: absolute;
		top: -6px;
	}

	.nav-toggle-icon::after {
		content: "";
		position: absolute;
		top: 6px;
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-icon {
		background-color: transparent;
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-icon::before {
		top: 0;
		transform: rotate(45deg);
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-icon::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.primary-nav {
		display: grid;
		grid-template-rows: 0fr;
		width: 100%;
		background-color: var(--color-white);
		border-bottom: 0 solid var(--color-gray-300);
		box-shadow: 0 12px 20px -8px rgba(19, 33, 60, 0.18);
		transition:
			grid-template-rows 0.25s ease,
			border-bottom-width 0.25s ease;
		position: relative;
		z-index: 60;
	}

	.primary-nav > ul {
		overflow: hidden;
	}

	.primary-nav.is-open {
		grid-template-rows: 1fr;
		border-bottom-width: 1px;
	}

	.primary-nav ul {
		list-style: none;
		margin: 0;
		padding: 0 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-width: var(--content-width);
		margin-inline: auto;
	}

	.primary-nav.is-open ul {
		padding-top: 0.5rem;
		padding-bottom: 1rem;
	}

	.primary-nav a {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0.5rem 0.25rem;
		color: var(--color-navy-900);
		text-decoration: none;
		font-weight: var(--weight-medium);
		border-bottom: 2px solid transparent;
	}

	.nav-backdrop {
		display: none;
		position: fixed;
		inset: 0;
		border: 0;
		padding: 0;
		background-color: rgba(19, 33, 60, 0.45);
		z-index: 50;
		cursor: default;
	}

	body.nav-open .nav-backdrop {
		display: block;
	}

	body.nav-open {
		overflow: hidden;
	}

	.primary-nav a:hover,
	.primary-nav a:focus-visible {
		color: var(--color-orange-600);
	}

	.primary-nav a[aria-current="page"] {
		color: var(--color-orange-600);
		font-weight: var(--weight-semibold);
		border-bottom-color: var(--color-orange-500);
	}

	@media (min-width: 900px) {
		.site-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			max-width: var(--content-width);
			margin: 0 auto;
			padding: 0 1.25rem;
			border-bottom: var(--border-hairline);
		}

		.bar {
			flex: 0 0 auto;
			max-width: none;
			margin: 0;
			padding: 1rem 0;
			border-bottom: 0;
		}

		.nav-toggle {
			display: none;
		}

		.nav-backdrop {
			display: none !important;
		}

		.primary-nav {
			display: block;
			grid-template-rows: unset;
			width: auto;
			box-shadow: none;
			background: none;
			z-index: auto;
		}

		.primary-nav > ul {
			overflow: visible;
		}

		.primary-nav ul {
			flex-direction: row;
			align-items: center;
			gap: 1.5rem;
			margin: 0;
			padding: 0;
			max-width: none;
		}

		.primary-nav.is-open ul {
			padding: 0;
		}

		.primary-nav a {
			min-height: auto;
			padding: 0.25rem 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.primary-nav,
		.nav-toggle-icon,
		.nav-toggle-icon::before,
		.nav-toggle-icon::after {
			transition: none;
		}
	}
</style>
