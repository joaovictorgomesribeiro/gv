---
import SocialIcon from "./SocialIcon.astro";
import { navItems } from "../data/nav";
import { address, siteName, social } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-grid">
		<div>
			<img class="footer-logo" src="/images/logo-gv-branca.png" alt={siteName} width="72" height="72" />
			<p>FOCO NA QUALIDADE: a GV é especialista naquilo que se propõe a fazer.</p>
		</div>

		<nav aria-label="Links do rodapé">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<p>{address.full}</p>
			<ul class="social-links">
				<li>
					<a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
						<SocialIcon network="facebook" />
					</a>
				</li>
				<li>
					<a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<SocialIcon network="instagram" />
					</a>
				</li>
				<li>
					<a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
						<SocialIcon network="linkedin" />
					</a>
				</li>
			</ul>
		</div>
	</div>

	<p class="copyright">
		© {siteName} {year}. Todos os direitos reservados.
		<a href="/politica-de-privacidade/">Política de Privacidade</a>
	</p>
</footer>

<style>
	.site-footer {
		background-color: var(--color-navy-900);
		color: var(--color-gray-100);
		padding: 2.5rem 1.25rem 1.5rem;
	}

	.footer-grid {
		max-width: var(--content-width);
		margin: 0 auto;
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr;
	}

	@media (min-width: 700px) {
		.footer-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.footer-logo {
		margin-bottom: 0.75rem;
	}

	.site-footer nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.social-links {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		display: flex;
		gap: 0.75rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: var(--radius-sm);
		color: var(--color-gray-100);
	}

	.site-footer a {
		color: var(--color-gray-100);
		text-decoration: underline;
	}

	.social-links a {
		text-decoration: none;
	}

	.site-footer a:hover,
	.site-footer a:focus-visible,
	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--color-orange-500);
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		border-color: var(--color-orange-500);
	}

	.copyright {
		max-width: var(--content-width);
		margin: 2rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		font-size: var(--text-sm);
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
</style>
