---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/fraunces/500.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/700.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StickyWhatsApp from "../components/StickyWhatsApp.astro";
import { address, businessHours, cnpj, email, siteName, social, telephoneE164 } from "../data/site";
import "../styles/tokens.css";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/images/og-cover.png", Astro.site);

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	name: siteName,
	url: Astro.site?.toString(),
	telephone: telephoneE164,
	email,
	taxID: cnpj,
	address: {
		"@type": "PostalAddress",
		streetAddress: `${address.street}, ${address.district}`,
		addressLocality: address.city,
		addressRegion: address.state,
		postalCode: address.zip,
		addressCountry: "BR",
	},
	openingHoursSpecification: {
		"@type": "OpeningHoursSpecification",
		dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
		opens: businessHours.opens,
		closes: businessHours.closes,
	},
	sameAs: [social.facebook, social.instagram, social.linkedin],
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:locale" content="pt_BR" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<meta name="generator" content={Astro.generator} />

		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
		<StickyWhatsApp />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		color: var(--color-gray-700);
		background-color: var(--color-white);
		line-height: 1.6;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-serif);
		color: var(--color-navy-900);
		line-height: 1.2;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
	}

	h2 {
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
	}

	h3 {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
	}

	@media (min-width: 700px) {
		h1 {
			font-size: var(--text-3xl);
		}

		h2 {
			font-size: var(--text-2xl);
		}
	}

	p {
		max-width: 68ch;
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	a {
		color: var(--color-orange-600);
	}

	a:hover,
	a:focus-visible {
		color: var(--color-orange-700);
	}

	:focus-visible {
		outline: 3px solid var(--color-orange-600);
		outline-offset: 2px;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		background-color: var(--color-navy-900);
		color: var(--color-white);
		padding: 0.75rem 1.25rem;
	}

	.skip-link:focus {
		left: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
